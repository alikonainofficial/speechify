# Copy to server/.env and fill in. Never commit the real .env.
PORT=8080

# Deepgram streaming speech-to-text (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Google Gemini for the AI clean-up step (optional; AI is disabled when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated list of origins allowed to call the server (CORS)
ALLOWED_ORIGINS=http://localhost:5173

# Public-demo limits (see step 2.5)
MAX_SESSION_SECONDS=60
MAX_CONCURRENT_STREAMS=3
DAILY_SECONDS_PER_IP=600
# Set to 1 behind a proxy (e.g. Render) so the client IP comes from X-Forwarded-For
TRUST_PROXY=0
